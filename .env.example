# ===========================================================
# LexAI 배포 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   그다음 아래 "필수 변경" 항목을 실제 값으로 채웁니다.
#
# 주의:
#   - 이 파일(.env.example)에는 절대 실제 비밀값을 넣지 마세요. git 에 올라갑니다.
#   - .env 는 .gitignore 에 등록되어 있습니다.
#   - 값에 $ 가 들어가면 docker compose 가 변수로 해석합니다. $$ 로 이스케이프하세요.
#     (! # @ 등은 그대로 써도 됩니다)
# ===========================================================


# ===========================================================
# 1. 외부 접속
#
# Caddy(리버스 프록시)를 걷어내면서 frontend 컨테이너가 80 포트를 직접
# 받습니다. 별도 설정 없이 http://<서버 IP> 로 접속합니다.
#
# HTTPS 가 필요해지면 CSP 의 로드밸런서(ALB / Cloud Load Balancing /
# Application Gateway)에서 인증서를 종료하는 쪽을 권합니다. 이관할 때
# 함께 옮겨야 할 구성 요소가 늘지 않습니다.
#
# (예전 SITE_ADDRESS 는 Caddy 전용이라 더 이상 쓰이지 않습니다)
# ===========================================================


# ===========================================================
# 2. 데이터베이스 — SQLite
#
# MySQL 을 대체했습니다. CSP 간 이관에서 관리형 DB 를 함께 옮기는 부담을
# 없애는 것이 목적입니다 — DB 가 파일 하나라 이관이 덤프/복원이 아니라
# 파일 복사가 됩니다.
#
# 사용자/비밀번호가 없습니다. 파일 권한이 곧 접근 제어입니다.
# ===========================================================
# DB 파일 경로. 반드시 절대경로로 두세요 — 상대경로는 프로세스의 작업
# 디렉터리를 따라가서, 실행 위치가 달라지면 빈 DB 를 새로 만들어버립니다.
#   Shell 형태 : /home/ubuntu/lexai-data/lexai.db
#   컨테이너   : /var/lib/lexai/lexai.db   (볼륨을 이 경로에 마운트)
DB_PATH=/home/ubuntu/lexai-data/lexai.db

# 기동 전에 스키마를 한 번 적용해야 합니다(Flyway 를 쓰지 않습니다):
#   sqlite3 "$DB_PATH" < deploy/schema.sqlite.sql


# ===========================================================
# 2-1. 타임존  ★ SQLite 에서는 필수입니다
#
# 스키마와 매퍼가 시각을 datetime('now','localtime') 으로 기록하는데,
# 이 localtime 은 JVM 설정이 아니라 프로세스의 OS 타임존을 따릅니다.
# 지정하지 않으면 리눅스 기본값(UTC)으로 기록되어 9시간 어긋납니다.
# ===========================================================
TZ=Asia/Seoul


# ===========================================================
# 3. JWT  ★ 필수 변경
# ===========================================================
# 기존 시크릿도 git 히스토리에 노출되어 있으므로 반드시 새로 생성하세요.
#   openssl rand -base64 48
# HS256 이므로 최소 32바이트 이상이어야 합니다.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRATION=86400000


# ===========================================================
# 4. 내부 서비스 주소 (컨테이너 이름 기반 — 보통 수정 불필요)
# ===========================================================
FASTAPI_URL=http://ai:8000

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_USE_SSL=true

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=legal-gemma
# 후속 질문 재작성 전용 경량 모델(법률 지식 불필요) — deploy/ollama-init.sh가 자동으로 받습니다.
OLLAMA_REWRITE_MODEL=gemma3:1b

# Redis 읽기 캐시 (선택 — 컨테이너 이름 기반 기본값으로 충분, 보통 수정 불필요)
REDIS_HOST=redis
REDIS_PORT=6379

# ===========================================================
# 5. OpenSearch  ★ 필수 변경
# ===========================================================
# 2.12 부터 초기 admin 비밀번호가 필수입니다. 없으면 컨테이너가 부팅에 실패합니다.
# 복잡도 요건: 대문자 + 소문자 + 숫자 + 특수문자 포함, 8자 이상
OPENSEARCH_PASSWORD=Change-Me-Opensearch-2026!
OPENSEARCH_INDEX=legal_documents

# JVM heap. 인스턴스 RAM 16GB 기준 2g 권장 (heap 은 전체 RAM 의 절반 이하)
OPENSEARCH_HEAP=2g


# ===========================================================
# 6. CORS
# ===========================================================
# 리버스 프록시로 프론트와 API 가 같은 오리진이 되므로 CORS 가 필요 없습니다.
# 빈 값 = Access-Control-Allow-Origin 헤더를 아예 내리지 않음 (운영 권장)
# 로컬 개발에서 프론트를 따로 띄울 때만 http://localhost:3000 등을 넣으세요.
CORS_ALLOWED_ORIGIN=


# ===========================================================
# 7. RAG / 추론 튜닝 (기본값으로 충분 — 필요할 때만 조정)
# ===========================================================
RAG_TOP_K=6
RAG_MIN_SCORE=0.5
MAX_NEW_TOKENS=768
TEMPERATURE=0.1
TOP_P=0.9

# 임베딩을 GPU 로 돌리려면 cuda (기본 cpu — 질문 1건이라 CPU 로도 50ms 수준)
EMBEDDING_DEVICE=cpu


# ===========================================================
# 8. 결정적 추론 — 이관 전후 동등성 검증용
#
# 평소 운영에서는 건드리지 않습니다. 이관 전후가 "같은 서비스"임을
# 비교할 때만 두 값을 함께 지정하세요.
#
#   TEMPERATURE=0     샘플링을 끄고 항상 최고 확률 토큰을 고릅니다
#   LLM_SEED=42       남은 무작위성의 시작점을 고정합니다 (-1 = 미지정)
#
# 주의: 결정적 설정이어도 GPU 세대가 다르면 부동소수점 연산 순서가 달라져
#       생성 텍스트의 완전 일치는 보장되지 않습니다. 검색 결과(top-k 문서)는
#       결정적이라 그쪽이 더 안정적인 비교 지표입니다.
# ===========================================================
#TEMPERATURE=0
#LLM_SEED=42


# ===========================================================
# 8. Registry 배포 (docker-compose.registry.yml 사용 시에만 필요)
#
# 소스 빌드 없이 이미지를 받아서 띄울 때 씁니다:
#   docker compose -f docker-compose.yml -f docker-compose.registry.yml up -d --no-build
#
# 기본값으로도 동작하므로, 다른 레지스트리로 옮길 때만 채우세요.
# ===========================================================
# Docker Hub 는 계정명, 그 외는 레지스트리 주소까지 포함합니다.
#   ECR : <계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com
#   GAR : asia-northeast3-docker.pkg.dev/<프로젝트>/<저장소>
#   ACR : <레지스트리>.azurecr.io
#REGISTRY_PREFIX=yunhwa0905

# 고정 태그를 쓰세요. latest 는 어느 이미지가 떴는지 추적이 안 됩니다.
#IMAGE_TAG=v1
