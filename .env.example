# ===========================================================
# LexAI 배포 환경변수 템플릿
#
# 사용법:
#   cp .env.example .env
#   그다음 아래 "필수 변경" 항목을 실제 값으로 채웁니다.
#
# 주의:
#   - 이 파일(.env.example)에는 절대 실제 비밀값을 넣지 마세요. git 에 올라갑니다.
#   - .env 는 .gitignore 에 등록되어 있습니다.
#   - 값에 $ 가 들어가면 docker compose 가 변수로 해석합니다. $$ 로 이스케이프하세요.
#     (! # @ 등은 그대로 써도 됩니다)
# ===========================================================


# ===========================================================
# 1. 도메인 / HTTPS  ★ 여기만 바꾸면 HTTP ↔ HTTPS 가 전환됩니다
# ===========================================================
# 도메인이 아직 없을 때 (HTTP, 탄력적 IP 로 직접 접속):
#   SITE_ADDRESS=:80
#
# 도메인이 준비되면 (HTTPS 자동 발급 — Caddy 가 인증서를 알아서 받아옵니다):
#   SITE_ADDRESS=lexai.example.com
#
# 조건: 해당 도메인의 A 레코드가 이 서버의 탄력적 IP(3.36.138.239)를
#       가리키고 DNS 전파가 끝난 뒤에 바꿔야 발급이 성공합니다.
SITE_ADDRESS=:80


# ===========================================================
# 2. MySQL  ★ 필수 변경
# ===========================================================
# git 히스토리에 노출된 기존 비밀번호(Legal1234!)는 절대 재사용하지 마세요.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=legal_chatbot
DB_USERNAME=legal
DB_PASSWORD=change-me-db-password

# 컨테이너 간 통신은 서비스 이름(mysql)으로 합니다. 보통 수정할 필요 없습니다.
DB_URL=jdbc:mysql://mysql:3306/legal_chatbot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8


# ===========================================================
# 3. JWT  ★ 필수 변경
# ===========================================================
# 기존 시크릿도 git 히스토리에 노출되어 있으므로 반드시 새로 생성하세요.
#   openssl rand -base64 48
# HS256 이므로 최소 32바이트 이상이어야 합니다.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRATION=86400000


# ===========================================================
# 4. 내부 서비스 주소 (컨테이너 이름 기반 — 보통 수정 불필요)
# ===========================================================
FASTAPI_URL=http://ai:8000

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_USE_SSL=true

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=legal-gemma


# ===========================================================
# 5. OpenSearch  ★ 필수 변경
# ===========================================================
# 2.12 부터 초기 admin 비밀번호가 필수입니다. 없으면 컨테이너가 부팅에 실패합니다.
# 복잡도 요건: 대문자 + 소문자 + 숫자 + 특수문자 포함, 8자 이상
OPENSEARCH_PASSWORD=Change-Me-Opensearch-2026!
OPENSEARCH_INDEX=legal_documents

# JVM heap. 인스턴스 RAM 16GB 기준 2g 권장 (heap 은 전체 RAM 의 절반 이하)
OPENSEARCH_HEAP=2g


# ===========================================================
# 6. CORS
# ===========================================================
# 리버스 프록시로 프론트와 API 가 같은 오리진이 되므로 CORS 가 필요 없습니다.
# 빈 값 = Access-Control-Allow-Origin 헤더를 아예 내리지 않음 (운영 권장)
# 로컬 개발에서 프론트를 따로 띄울 때만 http://localhost:3000 등을 넣으세요.
CORS_ALLOWED_ORIGIN=


# ===========================================================
# 7. RAG / 추론 튜닝 (기본값으로 충분 — 필요할 때만 조정)
# ===========================================================
RAG_TOP_K=6
RAG_MIN_SCORE=0.5
MAX_NEW_TOKENS=768
TEMPERATURE=0.1
TOP_P=0.9

# 임베딩을 GPU 로 돌리려면 cuda (기본 cpu — 질문 1건이라 CPU 로도 50ms 수준)
EMBEDDING_DEVICE=cpu
