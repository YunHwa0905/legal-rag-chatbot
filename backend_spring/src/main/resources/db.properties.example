# ===========================================================
# 로컬 개발용 기본값입니다.
#
# ★ 실제 비밀값을 이 파일에 넣지 마세요. git 에 추적되는 파일입니다.
#
# 배포(컨테이너) 환경에서는 backend_spring/docker-entrypoint.sh 가
# 기동 시점에 환경변수로부터 이 파일을 새로 생성해 덮어씁니다.
# 설정할 값의 목록과 설명은 프로젝트 루트의 .env.example 을 보세요.
#
# 로컬 STS 로 띄울 때는 아래 값을 본인 환경에 맞게 수정해서 쓰고,
# 수정한 내용을 커밋하지 않도록 주의하세요.
# ===========================================================

# 이 파일은 템플릿입니다. 실제 db.properties 는 기동 시점에 .env 로부터
# 자동 생성되므로 보통 직접 만들 필요가 없습니다
#   컨테이너 : backend_spring/docker-entrypoint.sh
#   Shell    : deploy/native/start.sh
#
# STS 등에서 직접 띄울 때만 복사해서 쓰세요:
#   cp db.properties.example db.properties
#
# SQLite - 파일 하나가 곧 DB 입니다. 사용자/비밀번호 개념이 없습니다.
#
# 경로는 상대경로면 프로세스의 작업 디렉터리 기준이라 실행 위치에 따라
# 다른 파일을 보게 됩니다. Shell 형태로 띄울 때는 절대경로를 쓰세요.
#   예) db.url=jdbc:sqlite:/home/ubuntu/lexai-data/lexai.db
#
# 스키마는 기동 전에 한 번 적용해야 합니다(Flyway 를 쓰지 않습니다):
#   sqlite3 <파일경로> < deploy/schema.sqlite.sql
db.driver.Class=org.sqlite.JDBC
db.url=jdbc:sqlite:./data/lexai.db

# 로컬에서 FastAPI 를 직접 띄웠을 때의 주소
fastapi.url=http://localhost:8000

# 로컬에서 Redis를 직접 띄웠을 때의 주소 (없어도 앱은 뜬다 — 캐시만 안 될 뿐)
redis.host=localhost
redis.port=6379

# 개발용 더미 시크릿 (HS256 이라 32바이트 이상 필요).
# 운영 값은 openssl rand -base64 48 로 새로 만들어 .env 에 넣으세요.
jwt.secret=local-development-only-secret-do-not-use-in-production
jwt.expiration=86400000
