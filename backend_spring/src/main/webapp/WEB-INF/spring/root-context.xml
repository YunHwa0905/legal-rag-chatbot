<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context.xsd
           http://www.springframework.org/schema/tx
           http://www.springframework.org/schema/tx/spring-tx.xsd">

    <context:property-placeholder location="classpath:db.properties"/>

    <context:component-scan base-package="com.legal.backend">
        <context:exclude-filter type="annotation"
            expression="org.springframework.stereotype.Controller"/>
    </context:component-scan>

    <!--
        SQLite DataSource.

        MySQL 과 다른 점 세 가지:

        1) username/password 가 없습니다. SQLite 는 파일 권한이 곧 접근 제어입니다.

        2) 풀 크기를 10 -> 5 로 줄였습니다. SQLite 는 writer 가 하나뿐이라
           커넥션을 늘려도 쓰기는 직렬화됩니다. WAL 덕분에 읽기는 병렬로 도니
           읽기 동시성만큼만 남깁니다.

        3) dataSourceProperties 의 세 PRAGMA 가 핵심입니다.
           - foreign_keys : SQLite 는 기본이 OFF 라, 걸지 않으면 스키마의 FK 가
                            선언만 되고 실제로 검사되지 않습니다.
           - busy_timeout : 비동기 요약/기억추출 스레드와 요청 스레드가 동시에
                            쓰므로, 없으면 SQLITE_BUSY 가 즉시 예외로 터집니다.
                            5초 동안 재시도하게 둡니다.
           - journal_mode : WAL. 스키마 파일에서 한 번 걸면 DB 에 유지되지만,
                            새로 만들어진 파일에도 확실히 적용되도록 여기서도 지정합니다.
    -->
    <bean id="dataSource" class="com.zaxxer.hikari.HikariDataSource" destroy-method="close">
        <property name="driverClassName" value="${db.driver.Class}"/>
        <property name="jdbcUrl"         value="${db.url}"/>
        <property name="maximumPoolSize" value="5"/>
        <property name="connectionTimeout" value="30000"/>
        <property name="dataSourceProperties">
            <props>
                <prop key="foreign_keys">true</prop>
                <prop key="busy_timeout">5000</prop>
                <prop key="journal_mode">WAL</prop>
            </props>
        </property>
    </bean>

    <!--
        Phase 0 최종 리뷰에서 발견된 갭: persistTurn의 user/assistant 두 INSERT가 트랜잭션 없이
        따로 커밋됐다(원래 root-context.xml에 트랜잭션 매니저 자체가 없었음). 두 번째 INSERT만
        실패하면 답 없는 orphan user 메시지가 남는 문제를 막기 위해 추가.
        ChatMessagePersistenceService.persistTurn()의 @Transactional이 이 매니저를 사용한다.
    -->
    <bean id="transactionManager" class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
        <property name="dataSource" ref="dataSource"/>
    </bean>
    <tx:annotation-driven transaction-manager="transactionManager"/>

    <bean id="sqlSessionFactory" class="org.mybatis.spring.SqlSessionFactoryBean">
        <property name="dataSource" ref="dataSource"/>
        <property name="mapperLocations" value="classpath:mybatis/*.xml"/>
        <property name="typeAliasesPackage" value="com.legal.backend.entity"/>
    </bean>

    <bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
        <property name="basePackage" value="com.legal.backend.dao"/>
    </bean>

    <bean id="passwordEncoder"
          class="org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder"/>

    <!--
        FastAPI 주소는 환경마다 다르므로 db.properties(=환경변수) 에서 읽습니다.
        컨테이너 배포 시에는 서비스 이름으로 접근합니다: http://ai:8000
    -->
    <bean id="webClient" class="org.springframework.web.reactive.function.client.WebClient"
          factory-method="create">
        <constructor-arg value="${fastapi.url}"/>
    </bean>

    <!--
        Redis 비활성화 (2026-09 CSP 이관 검증)

        미들웨어를 줄여 이관 부담을 낮추려고 껐습니다. 원래도 순수 읽기
        캐시(cache-aside)였고 원본은 항상 DB 라서, 꺼두어도 기능은 그대로
        동작합니다 — 캐시 미스가 될 뿐입니다.

        다시 켜려면 아래 세 빈의 주석을 풀고, ChatCacheService 의
        @Autowired(required = false) 를 원래대로 되돌리면 됩니다.

        ── 원래 설명 (보존) ─────────────────────────────────
        Redis는 순수 읽기 캐시(cache-aside)다 — 세션/인증 저장소가 아니다.
        연결은 지연(lazy)이어야 한다: 이 빈 생성 시점에 Redis가 안 떠 있어도
        애플리케이션 부팅이 실패하면 안 된다(ChatCacheService가 모든 호출을
        try/catch로 감싸 장애 시 DB로 폴백하는 게 전제다).

        커맨드 타임아웃(기본 60초)을 300ms 로 줄여둔 이유: Redis가 완전히
        죽어 연결이 즉시 거부되는 경우는 try/catch가 즉시 처리하지만, 응답
        없이 걸려만 있는 경우(네트워크 단절, OOM, BGSAVE 정체)엔 기본값이면
        요청 스레드가 60초씩 묶여 Tomcat 스레드풀이 고갈된다 — "Redis 장애는
        요청을 실패시키면 안 된다"는 전제를 정확히 뒤집는 실패 모드다.
        ────────────────────────────────────────────────────

        <bean id="redisStandaloneConfiguration"
              class="org.springframework.data.redis.connection.RedisStandaloneConfiguration">
            <constructor-arg index="0" value="${redis.host:localhost}"/>
            <constructor-arg index="1" value="${redis.port:6379}" type="int"/>
        </bean>

        <bean id="redisConnectionFactory"
              class="org.springframework.data.redis.connection.lettuce.LettuceConnectionFactory">
            <constructor-arg ref="redisStandaloneConfiguration"/>
            <property name="timeout" value="300"/>
        </bean>

        <bean id="stringRedisTemplate" class="org.springframework.data.redis.core.StringRedisTemplate">
            <constructor-arg ref="redisConnectionFactory"/>
        </bean>
    -->

</beans>